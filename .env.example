# All settings can be configured more conveniently in the web UI: http://<server-ip>/settings; those values take precedence over .env.
# .env provides initial values / a fallback.

# IMAP mailbox (Gmail: app password, not the account password)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# IMAP folder; empty = Gmail's "All Mail" (found by the \All attribute), otherwise INBOX
IMAP_FOLDER=

# Full sender domain or address; used only on the first run for the Maxima store
MAXIMA_FROM=maxima.lt

# Claude API key is optional: used to parse receipts from stores without a dedicated parser and to translate item names
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Schedule: once a day at HH:MM (container time, TZ in docker-compose). Empty = every SYNC_INTERVAL_MINUTES minutes
SYNC_DAILY_AT=08:00
SYNC_INTERVAL_MINUTES=60

# Required before first use: generate with python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Every /api route except /api/live requires X-Admin-Token. Never commit the generated value.
ADMIN_TOKEN=
